@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>Tạo bài thi mới</h2>
        </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs mb-3" id="taoBaiThiTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual"
                    type="button" role="tab" aria-controls="manual" aria-selected="true">
                <i class="bi bi-hand-index"></i> Chọn câu hỏi thủ công
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="random-chude-tab" data-bs-toggle="tab" data-bs-target="#random-chude"
                    type="button" role="tab" aria-controls="random-chude" aria-selected="false">
                <i class="bi bi-shuffle"></i> Ngẫu nhiên theo chủ đề
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="auto-tab" data-bs-toggle="tab" data-bs-target="#auto"
                    type="button" role="tab" aria-controls="auto" aria-selected="false">
                <i class="bi bi-magic"></i> Tạo từ câu hỏi hay sai
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="taoBaiThiTabContent">

        <!-- Tab 1: Manual Selection -->
        <div class="tab-pane fade show active" id="manual" role="tabpanel" aria-labelledby="manual-tab">
            <div class="card">
                <div class="card-body">
                    <form id="taoBaiThiForm">
                        <div class="mb-3">
                            <label for="tenBaiThi" class="form-label">Tên bài thi <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="tenBaiThi" name="tenBaiThi" required>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="loaiBangLai" class="form-label">Loại bằng lái <span class="text-danger">*</span></label>
                                <select id="loaiBangLai" class="form-select" required>
                                    <option value="">Tất cả loại bằng lái</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="chuDe" class="form-label">Chủ đề</label>
                                <select id="chuDe" class="form-select">
                                    <option value="">Tất cả chủ đề</option>
                                </select>
                            </div>
                        </div>
                        <table id="cauHoiTable" class="display table table-striped table-hover" style="width: 100%">
                            <thead>
                                <tr>
                                    <th>Nội dung</th>
                                    <th>Chọn</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <div class="mt-3 text-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Tạo bài thi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- Tab 2: Random theo chủ đề -->
        <!-- Tab 2: Random theo chủ đề -->
        <div class="tab-pane fade" id="random-chude" role="tabpanel" aria-labelledby="random-chude-tab">
            <div class="card">
                <div class="card-body">
                    <form id="taoBaiThiNgauNhienTheoChuDeForm">
                        <div class="mb-3">
                            <label class="form-label">Tên bài thi <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="tenBaiThiNgauNhienTheoChuDe" required>
                        </div>

                        <!-- THÊM DROPDOWN LOẠI BẰNG LÁI -->
                        <div class="mb-3">
                            <label for="loaiBangLaiTab2" class="form-label">Loại bằng lái <span class="text-danger">*</span></label>
                            <select id="loaiBangLaiTab2" class="form-select" required>
                                <option value="">-- Chọn loại bằng lái --</option>
                            </select>
                        </div>

                        <div id="chuDeSoLuongContainer"></div>

                        <div class="mt-3 text-end">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-shuffle"></i> Tạo bài thi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tab 3: Auto Generate from Hay Sai -->
        <div class="tab-pane fade" id="auto" role="tabpanel" aria-labelledby="auto-tab">
            <div class="card">
                <div class="card-body">
                    <form id="taoBaiThiHaySaiForm">
                        <div class="mb-3">
                            <label for="tenBaiThiAuto" class="form-label">Tên bài thi <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="tenBaiThiAuto" name="tenBaiThiAuto"
                                   placeholder="VD: Đề thi ôn luyện câu hỏi hay sai" required>
                        </div>

                        <div class="mb-3">
                            <label for="soLuong" class="form-label">Số lượng câu hỏi <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="soLuong" name="soLuong"
                                   min="1" max="100" value="20" required>
                            <div class="form-text">Hệ thống sẽ tự động chọn các câu hỏi có tỷ lệ sai cao nhất (từ 1 đến 100 câu)</div>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Lưu ý:</strong> Bài thi sẽ được tạo tự động từ các câu hỏi mà người dùng thường trả lời sai nhất dựa trên lịch sử thi.
                            Đây là cách tốt để tập trung ôn luyện những câu hỏi khó.
                        </div>

                        <div class="mt-3 text-end">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-magic"></i> Tạo bài thi tự động
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentLoaiBangLaiId = null;
        let currentChuDeId = null;
        let chuDeData = {}; // Lưu trữ chủ đề theo loại bằng lái
        let selectedCauHoiIds = new Set();

        $(document).ready(function () {
            // ==================== TAB 1: MANUAL SELECTION ====================

            // Khởi tạo DataTable server-side
            const table = $('#cauHoiTable').DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                searching: true,
                ordering: true,
                ajax: {
                    url: '/api/CauHoi/get-cau-hoi-on-theo-chu-de',
                    data: function (d) {
                        let chuDeIdValue = currentChuDeId && currentChuDeId !== '' ? currentChuDeId : null;
                        let loaiBangLaiIdValue = currentLoaiBangLaiId && currentLoaiBangLaiId !== '' ? currentLoaiBangLaiId : null;

                        return {
                            page: (d.start / d.length) + 1,
                            pageSize: d.length,
                            search: d.search. value,
                            sortCol: d.columns[d.order[0].column].data,
                            sortDir: d.order[0].dir,
                            chuDeId: chuDeIdValue,
                            loaiBangLaiId: loaiBangLaiIdValue
                        };
                    },
                    dataSrc: function (res) {
                        if (res.status && res.data) {
                            return res.data. items || res.data;
                        }
                        return [];
                    }
                },
                columns: [
                    {
                        data: 'noiDung',
                        render: function (data, type) {
                            return type === 'display' && data && data.length > 100 ?
                                data.substr(0, 100) + '...' : data || '';
                        }
                    },
                    {
                        data:  'id',
                        orderable: false,
                        render: function (data) {
                            const checked = selectedCauHoiIds.has(data) ? 'checked' : '';
                            return `<input type="checkbox" class="form-check-input cauhoi-checkbox"
                                           value="${data}" ${checked}>`;
                        }
                    }
                ],
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json'
                }
            });

            $('#cauHoiTable tbody').on('change', '.cauhoi-checkbox', function () {
                const id = $(this).val();
                if (this.checked) {
                    selectedCauHoiIds.add(id);
                } else {
                    selectedCauHoiIds.delete(id);
                }
            });

            // Load dữ liệu loại bằng lái và chủ đề
            loadBangLaiVaChuDe();

            // Sự kiện thay đổi loại bằng lái TAB 1
            $('#loaiBangLai').on('change', function () {
                const selectedId = $(this).val();
                currentLoaiBangLaiId = selectedId;
                loadChuDeOptions(selectedId);
                if (selectedId) {
                    currentChuDeId = null;
                    $('#chuDe').val('');
                    table.ajax.reload();
                } else {
                    table.clear().draw();
                }
            });

            // Sự kiện thay đổi chủ đề TAB 1
            $('#chuDe').on('change', function () {
                const value = $(this).val();
                currentChuDeId = value === '' ? null : value;
                table.ajax.reload();
            });

            // Submit form thủ công
            $('#taoBaiThiForm').on('submit', function (e) {
                e.preventDefault();

                const tenBaiThi = $('#tenBaiThi').val().trim();
                if (!tenBaiThi) {
                    Swal.fire('Lỗi! ', 'Vui lòng nhập tên bài thi.', 'error');
                    return;
                }

                if (! currentLoaiBangLaiId) {
                    Swal. fire('Lỗi! ', 'Vui lòng chọn loại bằng lái.', 'error');
                    return;
                }

                const selectedIds = Array.from(selectedCauHoiIds);

                if (selectedIds.length === 0) {
                    Swal. fire('Lỗi! ', 'Vui lòng chọn ít nhất một câu hỏi.', 'error');
                    return;
                }

                const request = {
                    TenBaiThi: tenBaiThi,
                    CauHoiIds: selectedIds
                };

                Swal.fire({
                    title: 'Đang tạo bài thi...',
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $. ajax({
                    url: '/api/BaiThi/tao-bai-thi',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công! ',
                                text: 'Bài thi đã được tạo.',
                                showConfirmButton: true,
                                timer: 1500
                            }).then(() => {
                                if (response.data && response.data.id) {
                                    window.location.href = `/Admin/ChiTietDeThi/${response.data.id}`;
                                } else {
                                    window.location.href = '/Admin/DanhSachBaiThi';
                                }
                            });
                        } else {
                            Swal.fire('Lỗi!', response.message || 'Không thể tạo bài thi. ', 'error');
                        }
                    },
                    error:  function (xhr, status, error) {
                        console.error('Error creating exam:', error);
                        let errorMessage = 'Đã xảy ra lỗi khi tạo bài thi.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        Swal.fire('Lỗi!', errorMessage, 'error');
                    }
                });
            });

            // ==================== TAB 2: RANDOM BY CHU DE ====================

            // Sự kiện thay đổi loại bằng lái TAB 2
            $('#loaiBangLaiTab2').on('change', function () {
                const selectedId = $(this).val();
                renderChuDeSoLuong(selectedId);
            });

            // Khi click vào tab 2 -> load dropdown loại bằng lái
            $('button[data-bs-target="#random-chude"]').on('shown.bs.tab', function () {
                // Load dropdown nếu chưa có dữ liệu
                if ($('#loaiBangLaiTab2 option').length === 1) {
                    loadLoaiBangLaiTab2();
                }
            });

            // Submit form ngẫu nhiên theo chủ đề
            $('#taoBaiThiNgauNhienTheoChuDeForm').on('submit', function (e) {
                e.preventDefault();

                const tenBaiThi = $('#tenBaiThiNgauNhienTheoChuDe').val().trim();
                if (!tenBaiThi) {
                    Swal.fire('Lỗi!', 'Vui lòng nhập tên bài thi.', 'error');
                    return;
                }

                const loaiBangLaiId = $('#loaiBangLaiTab2').val();
                if (!loaiBangLaiId) {
                    Swal. fire('Lỗi! ', 'Vui lòng chọn loại bằng lái.', 'error');
                    return;
                }

                const soLuongCauHoiTheoChuDe = [];

                $('.soLuongChuDeInput').each(function () {
                    const soLuong = parseInt($(this).val());
                    const chuDeId = $(this).data('chude-id');

                    if (soLuong && soLuong > 0) {
                        soLuongCauHoiTheoChuDe.push({
                            ChuDeId: chuDeId,
                            SoLuong: soLuong
                        });
                    }
                });

                if (soLuongCauHoiTheoChuDe.length === 0) {
                    Swal. fire('Lỗi! ', 'Vui lòng nhập số lượng cho ít nhất 1 chủ đề.', 'error');
                    return;
                }

                const request = {
                    TenBaiThi:  tenBaiThi,
                    LoaiBangLaiId: loaiBangLaiId,
                    SoLuongCauHoiTheoChuDe: soLuongCauHoiTheoChuDe
                };

                Swal.fire({
                    title: 'Đang tạo bài thi...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                $.ajax({
                    url: '/api/BaiThi/tao-bai-thi-ngau-nhien-theo-chu-de',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    success: function (response) {
                        if (response.success && response.data?. id) {
                            Swal.fire('Thành công!', 'Bài thi đã được tạo.', 'success')
                                .then(() => {
                                    window.location.href = `/Admin/ChiTietDeThi/${response.data. id}`;
                                });
                        } else {
                            Swal.fire('Lỗi!', response.message || 'Không thể tạo bài thi.', 'error');
                        }
                    },
                    error: function (xhr) {
                        let errorMessage = 'Đã xảy ra lỗi khi tạo bài thi.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = xhr.responseJSON. message;
                        }
                        Swal.fire('Lỗi!', errorMessage, 'error');
                    }
                });
            });

            // ==================== TAB 3: AUTO GENERATE ====================

            $('#taoBaiThiHaySaiForm').on('submit', function (e) {
                e.preventDefault();

                const tenBaiThi = $('#tenBaiThiAuto').val().trim();
                const soLuong = parseInt($('#soLuong').val());

                if (!tenBaiThi) {
                    Swal.fire('Lỗi!', 'Vui lòng nhập tên bài thi.', 'error');
                    return;
                }

                if (!soLuong || soLuong <= 0) {
                    Swal.fire('Lỗi!', 'Số lượng câu hỏi phải lớn hơn 0.', 'error');
                    return;
                }

                if (soLuong > 100) {
                    Swal. fire('Lỗi! ', 'Số lượng câu hỏi không được vượt quá 100.', 'error');
                    return;
                }

                const request = {
                    TenBaiThi: tenBaiThi,
                    SoLuong: soLuong
                };

                Swal.fire({
                    title: 'Đang tạo bài thi...',
                    html: 'Hệ thống đang phân tích và chọn các câu hỏi hay sai nhất.',
                    allowOutsideClick:  false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '/api/BaiThi/tao-bai-thi-hay-sai',
                    type:  'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    success: function (response) {
                        if (response.success && response.data && response.data.id) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: 'Bài thi đã được tạo thành công.',
                                showConfirmButton: true,
                                timer: 1500
                            }).then(() => {
                                window.location.href = `/Admin/ChiTietDeThi/${response.data.id}`;
                            });
                        } else {
                            Swal.fire('Lỗi!', response.message || 'Không thể tạo bài thi.', 'error');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error creating exam:', error);
                        let errorMessage = 'Đã xảy ra lỗi khi tạo bài thi. ';
                        if (xhr. responseJSON && xhr.responseJSON. message) {
                            errorMessage = xhr.responseJSON.message;
                        }
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi! ',
                            text: errorMessage
                        });
                    }
                });
            });

            $('#soLuong').on('input', function () {
                let value = parseInt($(this).val());
                if (value < 1) {
                    $(this).val(1);
                } else if (value > 100) {
                    $(this).val(100);
                }
            });
        });

        // ==================== HELPER FUNCTIONS ====================

        function loadBangLaiVaChuDe() {
            $.ajax({
                url: '/api/BaiThi/load-bang-lai-va-chu-de',
                type: 'GET',
                success: function (response) {
                    console.log('Response from load-bang-lai-va-chu-de:', response);
                    if (response.success && response.data && response.data. length > 0) {
                        const select = $('#loaiBangLai');
                        chuDeData = {};
                        response.data.forEach(item => {
                            select.append(`<option value="${item.bangLai. id}">${item.bangLai.tenLoai}</option>`);
                            chuDeData[item.bangLai.id] = item. chuDes;
                        });
                        // Tự động chọn loại bằng lái đầu tiên
                        const firstId = response.data[0].bangLai.id;
                        select.val(firstId).trigger('change');
                    } else {
                        console.warn('No data or success false');
                    }
                },
                error: function (xhr, status, error) {
                    console. error('Error loading bang lai:', error);
                    Swal. fire('Lỗi!', 'Không thể tải dữ liệu bằng lái và chủ đề.', 'error');
                }
            });
        }

        function loadChuDeOptions(loaiBangLaiId) {
            const select = $('#chuDe');
            select.empty().append('<option value="">Tất cả chủ đề</option>');
            if (chuDeData[loaiBangLaiId]) {
                chuDeData[loaiBangLaiId].forEach(chuDe => {
                    select.append(`<option value="${chuDe.id}">${chuDe.tenChuDe}</option>`);
                });
            }
            currentChuDeId = null;
            select.val('');
        }

        // Load loại bằng lái cho TAB 2
        function loadLoaiBangLaiTab2() {
            $.ajax({
                url: '/api/BaiThi/load-bang-lai-va-chu-de',
                type: 'GET',
                success: function (response) {
                    if (response.success && response.data && response.data.length > 0) {
                        const select = $('#loaiBangLaiTab2');
                        select.empty().append('<option value="">-- Chọn loại bằng lái --</option>');

                        response.data.forEach(item => {
                            select. append(`<option value="${item.bangLai.id}">${item.bangLai.tenLoai}</option>`);
                            chuDeData[item.bangLai.id] = item. chuDes;
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading bang lai tab 2:', error);
                    Swal.fire('Lỗi!', 'Không thể tải dữ liệu loại bằng lái. ', 'error');
                }
            });
        }

        // Render chủ đề và số lượng cho TAB 2
                // Render chủ đề và số lượng cho TAB 2
        function renderChuDeSoLuong(loaiBangLaiId) {
            const container = $('#chuDeSoLuongContainer');
            container.empty();

            if (!loaiBangLaiId || ! chuDeData[loaiBangLaiId]) {
                container.append('<div class="alert alert-warning">Vui lòng chọn loại bằng lái. </div>');
                return;
            }

            const chuDes = chuDeData[loaiBangLaiId];

            if (chuDes. length === 0) {
                container.append('<div class="alert alert-info">Không có chủ đề nào cho loại bằng lái này. </div>');
                return;
            }

            container.append('<h5 class="mb-3">Chọn số lượng câu hỏi tối đa cho mỗi chủ đề được chọn: </h5>');

            chuDes.forEach(cd => {
                container.append(`
                    <div class="row mb-2 align-items-center">
                        <div class="col-md-7">
                            <strong>${cd.tenChuDe}</strong>
                            ${cd.moTa ? `<small class="text-muted d-block">${cd.moTa}</small>` : ''}
                        </div>
                        <div class="col-md-5">
                            <input type="number"
                                   class="form-control soLuongChuDeInput"
                                   data-chude-id="${cd.id}"
                                   min="0"
                                   max="100"
                                   value="3"
                                   placeholder="Số câu (0 = bỏ qua)">
                        </div>
                    </div>
                `);
            });
        }
    </script>

    <style>
        .nav-tabs .nav-link {
            color: #6c757d;
        }

            .nav-tabs . nav-link.active {
                font-weight: 600;
            }

            . nav-tabs .nav-link:hover {
                color: #0d6efd;
            }

        #chuDeSoLuongContainer . row {
            border-bottom: 1px solid #e9ecef;
            padding: 10px 0;
        }

            #chuDeSoLuongContainer .row:last-child {
                border-bottom: none;
            }
    </style>
}
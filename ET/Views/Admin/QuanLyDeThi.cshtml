@{
    ViewData["Title"] = "Quản lý đề thi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold text-primary">
                <i class="bi bi-journal-text me-2"></i>Quản lý đề thi
            </h2>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-outline-primary me-2" id="btnRefresh">
                <i class="bi bi-arrow-clockwise me-1"></i>Làm mới
            </button>
            <a href="@Url.Action("ThemDeThi", "Admin")" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i>Thêm đề thi mới
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-filter me-1"></i>Loại bằng lái
                    </label>
                    <select id="loaiBangLaiFilter" class="form-select">
                        <option value="">Tất cả loại bằng lái</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-search me-1"></i>Tìm kiếm
                    </label>
                    <input type="text" id="searchInput" class="form-control" placeholder="Nhập tên đề thi... ">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" id="btnClearFilter">
                        <i class="bi bi-x-circle me-1"></i>Xóa lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold">Danh sách đề thi</h5>
                <span id="paginationInfo" class="text-muted"></span>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 60px;">STT</th>
                            <th>Tên đề thi</th>
                            <th class="text-center" style="width: 180px;">Loại bằng lái</th>
                            <th class="text-center" style="width: 120px;">Số câu hỏi</th>
                            <th class="text-center" style="width:  150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="danhSachDeThiBody">
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Đang tải...</span>
                                </div>
                                <p class="text-muted mt-2 mb-0">Đang tải dữ liệu...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận xoá -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xoá
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Bạn có chắc chắn muốn xoá đề thi: </p>
                <p class="fw-bold text-primary mb-3">"<span id="deleteExamName"></span>"</p>
                <div class="alert alert-danger mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Hành động này không thể hoàn tác!
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Hủy
                </button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <i class="bi bi-trash me-1"></i>Xác nhận xoá
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span id="successMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <span id="errorMessage"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script>
        let allDeThis = [];
        let loaiBangLais = [];
        let deleteExamId = null;
        let deleteModal = null;
        let successToast = null;
        let errorToast = null;

        document.addEventListener("DOMContentLoaded", function () {
            // Khởi tạo
            deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            successToast = new bootstrap.Toast(document.getElementById('successToast'));
            errorToast = new bootstrap.Toast(document.getElementById('errorToast'));

            // Load dữ liệu
            loadDeThiList();
            loadLoaiBangLai();

            // Events
            document.getElementById("searchInput").addEventListener("input", debounce(filterData, 300));
            document. getElementById("loaiBangLaiFilter").addEventListener("change", filterData);
            document.getElementById("btnRefresh").addEventListener("click", () => loadDeThiList(true));
            document.getElementById("btnClearFilter").addEventListener("click", clearFilters);
        });

        function debounce(func, wait) {
            let timeout;
            return function(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        function loadDeThiList(forceRefresh = false) {
            showLoading();

            const url = forceRefresh
                ? `/api/BaiThi/danh-sach-de-thi?t=${Date.now()}`
                : '/api/BaiThi/danh-sach-de-thi';

            fetch(url)
                .then(res => {
                    if (!res.ok) throw new Error(`Lỗi ${res.status}`);
                    return res.json();
                })
                .then(data => {
                    allDeThis = Array.isArray(data) ? data : [];
                    renderDeThiTable(allDeThis);
                    updatePaginationInfo(allDeThis.length, allDeThis.length);
                })
                .catch(err => {
                    showError(err.message);
                });
        }

        function loadLoaiBangLai() {
            fetch('/api/LoaiBangLai/danh-sach')
                .then(res => res.json())
                .then(data => {
                    loaiBangLais = Array.isArray(data) ? data : [];
                    const select = document.getElementById("loaiBangLaiFilter");

                    loaiBangLais.forEach(loai => {
                        const option = document.createElement("option");
                        option.value = loai. id;
                        option.textContent = loai.tenLoai || "Không có tên";
                        select.appendChild(option);
                    });
                })
                .catch(err => console.error(err));
        }

        function renderDeThiTable(data) {
            const tbody = document.getElementById("danhSachDeThiBody");

            if (! data || data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3 mb-0">Không tìm thấy đề thi nào</p>
                        </td>
                    </tr>`;
                return;
            }

            tbody.innerHTML = data.map((item, index) => `
                <tr>
                    <td class="text-center fw-semibold">${index + 1}</td>
                    <td>
                        <div class="fw-semibold text-dark">${htmlEncode(item.tenBaiThi || 'Không có tên')}</div>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-primary rounded-pill px-3 py-2">
                            ${htmlEncode(item.loaiBangLai || 'N/A')}
                        </span>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-info text-dark rounded-pill px-3 py-2">
                            ${item.soCau || 0} câu
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="/Admin/ChiTietDeThi/${item.id}" class="btn btn-outline-primary">
                                <i class="bi bi-eye"></i>
                            </a>
                            <button type="button" class="btn btn-outline-danger"
                                    onclick="showDeleteModal('${item.id}', '${htmlEncode(item.tenBaiThi).replace(/'/g, "\\'")}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
        }

        function filterData() {
            const searchTerm = document.getElementById("searchInput").value.toLowerCase().trim();
            const loaiBangLaiId = document.getElementById("loaiBangLaiFilter").value;

            let filtered = [... allDeThis];

            if (searchTerm) {
                filtered = filtered.filter(item =>
                    (item.tenBaiThi || '').toLowerCase().includes(searchTerm)
                );
            }

            if (loaiBangLaiId) {
                filtered = filtered.filter(item =>
                    String(item.loaiBangLaiId) === String(loaiBangLaiId)
                );
            }

            renderDeThiTable(filtered);
            updatePaginationInfo(filtered.length, allDeThis.length);
        }

        function clearFilters() {
            document.getElementById("searchInput").value = "";
            document. getElementById("loaiBangLaiFilter").value = "";
            filterData();
        }

        function updatePaginationInfo(showing, total) {
            const info = document.getElementById("paginationInfo");
            info.innerHTML = showing === total
                ? `<strong>${total}</strong> đề thi`
                : `<strong>${showing}</strong> / <strong>${total}</strong> đề thi`;
        }

        function showDeleteModal(id, name) {
            document.getElementById('deleteExamName').textContent = name;
            deleteExamId = id;

            document.getElementById('confirmDelete').onclick = () => deleteDeThi(deleteExamId);
            deleteModal.show();
        }

        function deleteDeThi(id) {
            const btn = document.getElementById('confirmDelete');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xoá...';

            fetch(`/api/BaiThi/${id}`, { method: 'DELETE' })
                .then(res => {
                    if (!res.ok) throw new Error('Xoá thất bại');
                    return res.json().catch(() => ({ success: true }));
                })
                .then(() => {
                    deleteModal.hide();
                    showSuccessToast('Xoá đề thi thành công!');
                    setTimeout(() => loadDeThiList(true), 500);
                })
                .catch(err => {
                    showErrorToast(err.message);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-trash me-1"></i>Xác nhận xoá';
                });
        }

        function showLoading() {
            document.getElementById("danhSachDeThiBody").innerHTML = `
                <tr>
                    <td colspan="5" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="text-muted mt-2 mb-0">Đang tải dữ liệu...</p>
                    </td>
                </tr>`;
        }

        function showError(message) {
            document.getElementById("danhSachDeThiBody").innerHTML = `
                <tr>
                    <td colspan="5" class="text-center py-5">
                        <i class="bi bi-exclamation-circle text-danger" style="font-size: 3rem;"></i>
                        <p class="text-danger mt-3 mb-2">Lỗi: ${message}</p>
                        <button class="btn btn-sm btn-outline-primary" onclick="loadDeThiList(true)">
                            <i class="bi bi-arrow-clockwise me-1"></i>Thử lại
                        </button>
                    </td>
                </tr>`;
        }

        function showSuccessToast(message) {
            document.getElementById('successMessage').textContent = message;
            successToast.show();
        }

        function showErrorToast(message) {
            document. getElementById('errorMessage').textContent = message;
            errorToast. show();
        }

        function htmlEncode(str) {
            if (! str) return '';
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }
    </script>

    <style>
        .card {
            border: none;
            border-radius: 12px;
        }

        .card-header {
            border-radius: 12px 12px 0 0 !important;
        }

        .table > thead {
            position: sticky;
            top: 0;
            z-index:  10;
        }

        .table > tbody > tr {
            transition: all 0.2s ease;
        }

        .table > tbody > tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
        }

        .btn-group-sm > .btn {
            padding: 0.375rem 0.75rem;
        }

        .badge {
            font-weight: 500;
            letter-spacing: 0.3px;
        }

        . modal-content {
            border:  none;
            border-radius:  12px;
        }

        .toast {
            min-width: 300px;
        }

        .form-select:focus,
        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
        }
    </style>
}
@{
    ViewData["Title"] = "Thêm bài sa hình";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <h2 class="mb-4">Thêm bài sa hình</h2>

    <form id="createForm">
        <div class="form-group">
            <label for="TenBai">Tên bài</label>
            <input type="text" id="TenBai" class="form-control" required />
        </div>

        <div class="form-group">
            <label for="Order">Thứ tự</label>
            <input type="number" id="Order" class="form-control" required />
        </div>

    
        <div class="form-group">
            <label for="NoiDung">Nội dung *</label>
            <textarea id="NoiDung" class="form-control"></textarea>
        </div>

        <div class="form-group">
            <label for="LoaiBangLaiId">Loại bằng lái</label>
            <select id="LoaiBangLaiId" class="form-control" required></select>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Thêm bài</button>
    </form>
</div>

@section Scripts {

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <script>
        fetch('/api/LoaiBangLai/get-loai-bang-lai-list')
            .then(res => res.json())
            .then(data => {
                const select = document.getElementById("LoaiBangLaiId");
                data.data.forEach(loai => {
                    const option = document.createElement("option");
                    option.value = loai.id;
                    option.text = loai.tenLoai;
                    select.appendChild(option);
                });
            });

    
        class UploadAdapter {
            constructor(loader) {
                this.loader = loader;
            }

            upload() {
                return this.loader.file.then(file => new Promise((resolve, reject) => {
                    const formData = new FormData();
                    formData.append("file", file);

                    let uploadUrl = file.type.startsWith("video/")
                        ? "/api/Upload/upload-video"
                        : "/api/Upload/upload-image";

                    fetch(uploadUrl, {
                        method: "POST",
                        body: formData
                    })
                        .then(res => res.json())
                        .then(result => {
                            if (!result.status) {
                                reject(result.message);
                                return;
                            }

                            resolve({
                                default: result.filePath
                            });
                        })
                        .catch(err => reject(err));
                }));
            }

            abort() { }
        }

        function CustomUploadAdapterPlugin(editor) {
            editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
                return new UploadAdapter(loader);
            };
        }

        let editorInstance;

   
        ClassicEditor
            .create(document.querySelector('#NoiDung'), {
                extraPlugins: [CustomUploadAdapterPlugin],
                mediaEmbed: { previewsInData: true }
            })
            .then(editor => editorInstance = editor)
            .catch(err => console.error(err));


        // Xử lý sự kiện Submit Form
         document.getElementById("createForm").addEventListener("submit", async function (e) {
             e.preventDefault();

             // 1. Lấy dữ liệu từ Form
             const inputTenBai = document.getElementById("TenBai").value.trim();
             const inputOrder = parseInt(document.getElementById("Order").value);
             const inputLoaiBangLaiId = document.getElementById("LoaiBangLaiId").value;

             // Lấy dữ liệu từ CKEditor
             const noiDungValue = editorInstance.getData();

             // 2. VALIDATE NỘI DUNG (Bắt buộc nhập)
             if (!noiDungValue || noiDungValue.trim() === "") {
                 alert("Vui lòng nhập nội dung cho bài sa hình!");
                 return;
             }

             // 3. KIỂM TRA TRÙNG LẶP (Logic mới thêm)
             try {
                 // Gọi API lấy danh sách các bài sa hình thuộc loại bằng lái đang chọn
                 // Đặt pageSize lớn (ví dụ 1000) để đảm bảo lấy hết danh sách về để so sánh
                 const resCheck = await fetch(`/api/SaHinh/paged-bai-sa-hinh?page=1&pageSize=1000&search=&sortCol=&sortDir=&loaiBangLaiId=${inputLoaiBangLaiId}`);
                 const resultCheck = await resCheck.json();

                 if (resultCheck.data && resultCheck.data.length > 0) {
                     // Kiểm tra trùng Tên bài (Không phân biệt hoa thường)
                     const isDuplicateName = resultCheck.data.some(bai => bai.tenBai.toLowerCase() === inputTenBai.toLowerCase());
                     if (isDuplicateName) {
                         alert(`Lỗi: Tên bài "${inputTenBai}" đã tồn tại trong danh sách của bằng này!`);
                         return; // Dừng lại, không gửi dữ liệu
                     }

                     // Kiểm tra trùng Thứ tự (Order)
                     const isDuplicateOrder = resultCheck.data.some(bai => bai.order === inputOrder);
                     if (isDuplicateOrder) {
                         alert(`Lỗi: Thứ tự số ${inputOrder} đã được sử dụng cho bài khác!`);
                         return; // Dừng lại, không gửi dữ liệu
                     }
                 }
             } catch (error) {
                 console.error("Lỗi kiểm tra trùng lặp:", error);
                 alert("Không thể kiểm tra dữ liệu trùng lặp. Vui lòng thử lại.");
                 return;
             }

             // 4. GỬI DỮ LIỆU TẠO MỚI (Nếu không bị trùng)
             const data = {
                 TenBai: inputTenBai,
                 Order: inputOrder,
                 NoiDung: noiDungValue,
                 LoaiBangLaiId: inputLoaiBangLaiId
             };

             try {
                 const resCreate = await fetch("/api/SaHinh/create", {
                     method: "POST",
                     headers: { "Content-Type": "application/json" },
                     body: JSON.stringify(data)
                 });

                 const result = await resCreate.json();

                 if (result.status) {
                     alert("Thêm bài sa hình thành công!");
                     location.href = "/Admin/QLSaHinh";
                 } else {
                     alert("Lỗi hệ thống: " + result.message);
                 }
             } catch (err) {
                 alert("Lỗi kết nối: " + err.message);
             }
         });
    </script>
}
